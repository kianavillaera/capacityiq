# .env.example — copy this to .env and fill in real values.
# .env is listed in .gitignore and is never committed.

# Sheet name inside Resources.xlsx that contains the roster.
RESOURCES_SHEET=Resource List YYYYMMDD

# JSON object: ServiceNow User ID → exact roster Name.
# Add an entry when someone's email-derived UID differs from their TC User ID.
# Example:  UID_OVERRIDES={"tc.userid": "Surname, Firstname"}
UID_OVERRIDES={}

# JSON array of first-name strings for reduced-hours members.
# These members are Compliant if they log any hours at all (threshold does not apply).
# Example:  PARTIAL_HOURS_EXCEPTIONS=["FirstName1", "First Name2"]
PARTIAL_HOURS_EXCEPTIONS=[]

# FTE utilisation rate. 1 FTE = 40 * UTILIZATION_RATE hours/week.
# Example: 0.85 means 1 FTE = 34 h/week
UTILIZATION_RATE=0.85

# Target weekly FTE band [lower, upper] for the Power BI in-band flag.
FTE_BAND=[100, 119]

# JSON object mapping ServiceNow technology names to Power BI report group labels.
# Example: TECH_MAP={"Technology A": "Group 1", "Technology B": "Group 2"}
TECH_MAP={}
